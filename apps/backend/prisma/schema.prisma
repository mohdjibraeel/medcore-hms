generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Address {
  id        String     @id @default(cuid())
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String     @default("India")
  hospitals Hospital[]
  patients  Patient[]
}

model Hospital {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  status       HospitalStatus @default(PENDING)
  addressId    String?
  createdAt    DateTime       @default(now())
  appointments Appointment[]
  departments  Department[]
  address      Address?       @relation(fields: [addressId], references: [id])
  invoices     Invoice[]
  labTests     LabTest[]
  medicines    Medicine[]
  users        User[]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          Role
  hospitalId    String?
  createdAt     DateTime       @default(now())
  firstName     String
  lastName      String?
  doctor        Doctor?
  notifications Notification[]
  patient       Patient?
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id])
}

model Doctor {
  id             String          @id @default(cuid())
  userId         String          @unique
  specialization String
  licenseNumber  String          @unique
  departmentId   String
  createdAt      DateTime        @default(now())
  appointments   Appointment[]
  department     Department      @relation(fields: [departmentId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  medicalRecords MedicalRecord[]
}

model Department {
  id           String        @id @default(cuid())
  name         String
  hospitalId   String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
}

model Patient {
  id             String          @id @default(cuid())
  userId         String          @unique
  dateOfBirth    DateTime
  bloodGroup     String?
  addressId      String?
  createdAt      DateTime        @default(now())
  appointments   Appointment[]
  invoices       Invoice[]
  medicalRecords MedicalRecord[]
  address        Address?        @relation(fields: [addressId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  doctorId       String
  departmentId   String
  hospitalId     String
  scheduledAt    DateTime
  status         AppointmentStatus @default(PENDING)
  isEmergency    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  department     Department        @relation(fields: [departmentId], references: [id])
  doctor         Doctor            @relation(fields: [doctorId], references: [id])
  hospital       Hospital          @relation(fields: [hospitalId], references: [id])
  patient        Patient           @relation(fields: [patientId], references: [id])
  invoices       Invoice?
  medicalRecords MedicalRecord?
}

model MedicalRecord {
  id             String         @id @default(cuid())
  appointmentId  String         @unique
  patientId      String
  doctorId       String
  bloodPressure  String?
  pulse          Int?
  temperature    Float?
  spo2           Int?
  heightCm       Float?
  weightKg       Float?
  chiefComplaint String
  diagnosis      String?
  treatmentPlan  String?
  allergies      String?
  createdAt      DateTime       @default(now())
  labOrders      LabOrder[]
  appointment    Appointment    @relation(fields: [appointmentId], references: [id])
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  prescriptions  Prescription[]
}

model Medicine {
  id                String             @id @default(cuid())
  name              String
  form              MedicineForm
  hospitalId        String
  reorderLevel      Int                @default(10)
  createdAt         DateTime           @default(now())
  hospital          Hospital           @relation(fields: [hospitalId], references: [id])
  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id              String             @id @default(cuid())
  medicalRecordId String
  createdAt       DateTime           @default(now())
  doctorId        String
  patientId       String
  notes           String?
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  items           PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  frequency      Frequency
  durationDays   Int
  instructions   String?
  dosageUnit     String
  quantity       Int
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model MedicineBatch {
  id              String   @id @default(cuid())
  medicineId      String
  batchNumber     String
  manufactureDate DateTime
  expiryDate      DateTime
  quantity        Int
  unitCost        Float
  mrp             Float
  isQuarantined   Boolean  @default(false)
  createdAt       DateTime @default(now())
  medicine        Medicine @relation(fields: [medicineId], references: [id])
}

model LabTest {
  id           String         @id @default(cuid())
  name         String
  unit         String
  refRangeLow  Float?
  refRangeHigh Float?
  hospitalId   String
  labOrders    LabOrderItem[]
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
}

model LabOrder {
  id              String         @id @default(cuid())
  medicalRecordId String
  status          LabOrderStatus @default(ORDERED)
  createdAt       DateTime       @default(now())
  medicalRecord   MedicalRecord  @relation(fields: [medicalRecordId], references: [id])
  items           LabOrderItem[]
}

model LabOrderItem {
  id          String   @id @default(cuid())
  labOrderId  String
  labTestId   String
  resultValue Float?
  isFlagged   Boolean  @default(false)
  reportUrl   String?
  labOrder    LabOrder @relation(fields: [labOrderId], references: [id])
  labTest     LabTest  @relation(fields: [labTestId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  patientId     String
  hospitalId    String
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Float         @default(0)
  razorpayOrderId String?     @unique
  createdAt     DateTime      @default(now())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  hospital      Hospital      @relation(fields: [hospitalId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String              @id @default(cuid())
  invoiceId   String
  description String
  category    InvoiceItemCategory
  amount      Float
  invoice     Invoice             @relation(fields: [invoiceId], references: [id])
}

model Notification {
  id               String           @id @default(cuid())
  userId           String
  type             NotificationType
  title            String
  message          String
  isRead           Boolean          @default(false)
  linkedEntityId   String?
  linkedEntityType String?
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   String?
  createdAt  DateTime @default(now())
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum HospitalStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EMERGENCY
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  TOPICAL
}

enum Frequency {
  OD
  BD
  TDS
  QID
  SOS
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  RESULT_UPLOADED
  APPROVED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

enum InvoiceItemCategory {
  CONSULTATION
  LAB
  PHARMACY
  ROOM
  OTHER
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  LAB_REPORT_APPROVED
  PRESCRIPTION_READY
  INVOICE_GENERATED
  PAYMENT_RECEIVED
  LOW_STOCK_ALERT
  EMERGENCY_APPOINTMENT
}
